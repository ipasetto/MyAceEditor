<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyAceEditor</RootNamespace>
    <AssemblyName>MyAceEditor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modo mcp: servidor MCP por stdio para um agente de IA (igual ao Angelica Core) -->
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Update="sample.data" CopyToOutputDirectory="PreserveNewest" />
    <None Update="PerfectWorld\cfg\**\*.cfg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Catálogos de idioma (lang/*.json): ficam ao lado do executável para a comunidade editar sem recompilar -->
    <None Update="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
