<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyAceEditor</RootNamespace>
    <AssemblyName>MyAceEditor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesmo pacote MCP que o Angelica Core usa (modo mcp) -->
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copia a UI e o módulo de exemplo para a saída do build -->
    <None Update="sample.data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
