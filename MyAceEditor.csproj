<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyAceEditor</RootNamespace>
    <AssemblyName>MyAceEditor</AssemblyName>
    <Version>1.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- desempenho (ENGINE-KB §E7, teste load-bench): abrir um elements/tasks cria milhões de objetos pequenos; sem a coleta
         concorrente o coletor não disputa com a leitura (PWI 1.5.5: 6,5 s -> 4,9 s e menos memória). Mesmo efeito de
         DOTNET_gcConcurrent=0; GCSettings.LatencyMode = Batch só durante a abertura não deu o mesmo ganho. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <!-- Modo mcp: servidor MCP por stdio para um agente de IA (igual ao Angelica Core) -->
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Plugins\**\*.cs" />   <!-- programa dos plugins (Linux): projeto próprio Plugins/MyAcePlugins.csproj -->
    <!-- Logo: ícone do .exe (ApplicationIcon) e das janelas (Program.UseAppIcon) -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="MyAceEditor.app.ico" />
    <EmbeddedResource Include="Assets\map_names.tsv" LogicalName="MyAceEditor.map_names.tsv" />
    <None Update="sample.data" CopyToOutputDirectory="PreserveNewest" />
    <None Update="PerfectWorld\cfg\**\*.cfg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="PerfectWorld\cfg\*.tsv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- CatÃ¡logos de idioma (lang/*.json): ficam ao lado do executÃ¡vel para a comunidade editar sem recompilar -->
    <None Update="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Servidor local (WSL): scripts que o programa copia para dentro do Linux -->
    <None Update="Server\*.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- programa dos plugins (Linux), publicado em Plugins/out: vai junto do editor em plugins/ -->
  <ItemGroup Condition="Exists('Plugins\out\myaceplugins')">
    <None Include="Plugins\out\myaceplugins" Link="plugins\myaceplugins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
