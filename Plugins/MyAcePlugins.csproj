<Project Sdk="Microsoft.NET.Sdk">

  <!-- Programa dos plugins de evento (docs/PLUGINS.md): roda no servidor Linux/WSL, sempre ligado.
       Publicar: dotnet publish Plugins/MyAcePlugins.csproj -c Release -r linux-x64 -o Plugins/out -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>myaceplugins</AssemblyName>
    <RootNamespace>MyAceEditor.Plugins</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PerfectWorld\Gnet.cs" Link="Shared\Gnet.cs" />
    <Compile Include="..\PerfectWorld\PluginRules.cs" Link="Shared\PluginRules.cs" />
  </ItemGroup>

</Project>
