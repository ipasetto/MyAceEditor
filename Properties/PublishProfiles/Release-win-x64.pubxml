<?xml version="1.0" encoding="utf-8"?>
<!--
  Distribution build (2026-11-09): one MyAceEditor.exe with .NET inside (runs without installing anything, Windows 7
  included), compressed, without ReadyToRun. Measured: .exe 161 MB -> 54 MB, same results in the 3D World checks,
  start-up about 0.13 s slower. Do not turn on trimming: WinForms does not support it.
  Use:  dotnet publish -c Release -p:PublishProfile=Release-win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>dist\</PublishDir>
  </PropertyGroup>
</Project>
